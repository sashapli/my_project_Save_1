--- !u!114 &59804310
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 59804305}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1e155245bb2a96343b37576a8267d2fe, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  group: {fileID: 1674005258}
  group2: {fileID: 821514943}
  group3: {fileID: 1342561297}
  perentFood: {fileID: 807983221}
  perentFish: {fileID: 1204803844}
  PlayerFish: {fileID: 6775989371151895282}
  fishMenager: {fileID: 2131087571}
  turelApplay: {fileID: 1086289734}
  CiuntSecund: 0
  late: 0
  isStart: 0
  Timer: {fileID: 922000353}
  MINU: {fileID: 1256661930}
  Shop: {fileID: 1718540233}
  option: {fileID: 8266680203425564809}
  Camper: {fileID: 1086289730}
  description: {fileID: 1013785764}
  MoneyCur: {fileID: 428299772}
  descriptionAllRu:
  - "\u041C\u0435\u0442\u0430\u0431\u043E\u043B\u0438\u0437\u043C \u2014 \u044D\u0442\u043E
    \u0442\u0432\u043E\u044F \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u044F \u044D\u043D\u0435\u0440\u0433\u0438\u0438.
    \u041A\u0430\u0436\u0434\u044B\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
    \u044D\u0442\u043E\u0433\u043E \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F
    \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u0435\u0442 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
    \u043F\u0430\u0434\u0435\u043D\u0438\u044F \u0448\u043A\u0430\u043B\u044B \u0433\u043E\u043B\u043E\u0434\u0430,
    \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044F \u0442\u0435\u0431\u0435 \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F
    \u0432 \u0438\u0433\u0440\u0435 \u0434\u043E\u043B\u044C\u0448\u0435 \u0438 \u043D\u0435
    \u043E\u0442\u0432\u043B\u0435\u043A\u0430\u0442\u044C\u0441\u044F \u043D\u0430
    \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0435 \u043F\u043E\u0438\u0441\u043A\u0438
    \u0435\u0434\u044B. \u0411\u0435\u0437 \u043D\u0435\u0433\u043E \u0431\u043E\u043B\u044C\u0448\u0430\u044F
    \u0430\u043A\u0443\u043B\u0430 \u0443\u043C\u0438\u0440\u0430\u0435\u0442 \u043E\u0442
    \u0433\u043E\u043B\u043E\u0434\u0430 \u0437\u0430 \u0441\u0447\u0438\u0442\u0430\u043D\u043D\u044B\u0435
    \u0441\u0435\u043A\u0443\u043D\u0434\u044B, \u0430 \u0441 \u043F\u0440\u043E\u043A\u0430\u0447\u043A\u043E\u0439
    \u0442\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0448\u044C \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
    \u043F\u043B\u0430\u0432\u0430\u0442\u044C \u043D\u0430 \u0433\u043B\u0443\u0431\u0438\u043D\u0435
    \u0432 \u0434\u0432\u0430-\u0442\u0440\u0438 \u0440\u0430\u0437\u0430 \u0434\u043E\u043B\u044C\u0448\u0435,"
  - "\u0447\u0435\u043B\u044E\u0441\u0442\u044C \u2014 \u044D\u0442\u043E \u0442\u0432\u043E\u044F
    \u043E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u0441\u0438\u043B\u0430. \u0423\u043B\u0443\u0447\u0448\u0430\u044F
    \u0447\u0435\u043B\u044E\u0441\u0442\u044C, \u0442\u044B \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0448\u044C
    \u0443\u0440\u043E\u043D \u043E\u0442 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
    \u0443\u043A\u0443\u0441\u0430, \u0438 \u0442\u0435\u043F\u0435\u0440\u044C \u0442\u0435\u0431\u0435
    \u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0442\u0440\u0430\u0442\u0438\u0442\u044C
    \u043F\u044F\u0442\u044C \u043A\u0430\u0441\u0430\u043D\u0438\u0439 \u043D\u0430
    \u043E\u0434\u043D\u0443 \u043A\u0440\u0443\u043F\u043D\u0443\u044E \u0440\u044B\u0431\u0443
    \u2014 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0434\u0432\u0443\u0445
    \u0438\u043B\u0438 \u0434\u0430\u0436\u0435 \u043E\u0434\u043D\u043E\u0433\u043E.
    \u042D\u0442\u043E \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438
    \u0432\u0430\u0436\u043D\u043E, \u043A\u043E\u0433\u0434\u0430 \u0432\u043E\u043A\u0440\u0443\u0433
    \u043F\u043B\u0430\u0432\u0430\u044E\u0442 \u0440\u044B\u0431\u044B \u0441 \u0431\u043E\u043B\u044C\u0448\u0438\u043C
    \u0437\u0430\u043F\u0430\u0441\u043E\u043C \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F,
    \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043A\u0430\u0436\u0434\u0430\u044F
    \u043B\u0438\u0448\u043D\u044F\u044F \u0441\u0435\u043A\u0443\u043D\u0434\u0430
    \u0431\u043E\u044F \u043E\u0442\u043D\u0438\u043C\u0430\u0435\u0442 \u0443 \u0442\u0435\u0431\u044F
    \u0433\u043E\u043B\u043E\u0434, \u0430 \u0441 \u043C\u043E\u0449\u043D\u043E\u0439
    \u0447\u0435\u043B\u044E\u0441\u0442\u044C\u044E \u0442\u044B \u0440\u0430\u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0448\u044C\u0441\u044F
    \u0441 \u0434\u043E\u0431\u044B\u0447\u0435\u0439 \u043C\u043E\u043B\u043D\u0438\u0435\u043D\u043E\u0441\u043D\u043E,
    \u043F\u043E\u043B\u0443\u0447\u0430\u044F \u043D\u0430\u0433\u0440\u0430\u0434\u0443
    \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445 \u043F\u043E\u0442\u0435\u0440\u044C."
  - "\u0422\u0443\u0440\u0435\u043B\u0438 \u2014 \u044D\u0442\u043E \u0442\u0432\u043E\u044F
    \u043E\u0433\u043D\u0435\u0432\u0430\u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430.
    \u041D\u0430 \u0441\u043F\u0438\u043D\u0435 \u0430\u043A\u0443\u043B\u044B \u0443\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043C\u0438\u043D\u0438-\u043F\u0443\u0448\u043A\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0441\u0430\u043C\u0438 \u043D\u0430\u0445\u043E\u0434\u044F\u0442 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0443\u044E
    \u0440\u044B\u0431\u0443 \u0438 \u0441\u0442\u0440\u0435\u043B\u044F\u044E\u0442
    \u0432 \u043D\u0435\u0451 \u043A\u0430\u0436\u0434\u044B\u0435 \u043F\u0430\u0440\u0443
    \u0441\u0435\u043A\u0443\u043D\u0434. \u041E\u043D\u0438 \u043D\u0435 \u0437\u0430\u043C\u0435\u043D\u044F\u044E\u0442
    \u0442\u0432\u043E\u0438 \u0443\u043A\u0443\u0441\u044B, \u043D\u043E \u0437\u0434\u043E\u0440\u043E\u0432\u043E
    \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442: \u0434\u043E\u0431\u0438\u0432\u0430\u044E\u0442
    \u0440\u0430\u043D\u0435\u043D\u0443\u044E \u043C\u0435\u043B\u043E\u0447\u044C,
    \u043F\u043E\u043A\u0430 \u0442\u044B \u0437\u0430\u043D\u044F\u0442 \u043A\u0440\u0443\u043F\u043D\u043E\u0439
    \u0446\u0435\u043B\u044C\u044E, \u0441\u0431\u0438\u0432\u0430\u044E\u0442 \u043B\u0438\u0448\u043D\u0435\u0435
    \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u0443 \u0442\u043E\u043B\u0441\u0442\u043E\u043A\u043E\u0436\u0438\u0445
    \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432 \u0434\u043E
    \u0442\u0432\u043E\u0435\u0433\u043E \u043F\u043E\u0434\u0445\u043E\u0434\u0430
    \u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043E\u0437\u0434\u0430\u044E\u0442
    \u0445\u0430\u043E\u0441 \u0432 \u0441\u0442\u0430\u0435, \u043E\u0442\u0432\u043B\u0435\u043A\u0430\u044F
    \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043D\u044B\u0445 \u0440\u044B\u0431
    \u043E\u0442 \u0442\u0435\u0431\u044F. \u042D\u0442\u043E \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442
    \u043E\u0445\u043E\u0442\u0443 \u0432 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439
    \u0431\u043E\u0435\u0432\u043E\u0439 \u0440\u0435\u0439\u0434, \u0433\u0434\u0435
    \u0443 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C \u0432\u0435\u0440\u043D\u044B\u0439
    \u0436\u0435\u043B\u0435\u0437\u043D\u044B\u0439 \u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A.  "
  descriptionAllEn:
  - "Metabolism is your energy\u2011saving mechanism. Each level of this upgrade
    slows down the rate at which the hunger bar drops, allowing you to stay in the
    game longer and not be distracted by constantly searching for food. Without it,
    a large shark would die of hunger in a matter of seconds, but with the upgrade,
    you get the ability to swim at depth for two to three times longer."
  - "The jaw is your main strength. By improving the jaw, you increase the damage
    from each bite, and now you don\u2019t need to waste five touches on one large
    fish\_\u2014\_two or even one will do. This is critically important when there
    are fish with a large health pool swimming around, because every extra second
    of combat drains your hunger, and with a powerful jaw you can deal with prey
    lightning\u2011fast, getting the reward without unnecessary losses."
  - "Turrets are your fire support. Automatic mini\u2011guns are installed on the
    shark\u2019s back; they automatically find the nearest fish and shoot at it every
    couple of seconds. They don\u2019t replace your bites, but they\u2019re a great
    help: they finish off wounded small fish while you\u2019re busy with a larger
    target, reduce the excess health of thick\u2011skinned opponents before you get
    close, and simply create chaos in the school, distracting aggressive fish from
    you. This turns hunting into a real combat raid, where you have a loyal iron
    companion."
  AllSell:
  - money: 0f0000001900000028000000320000004100000050000000640000007800000091000000b4000000
  - money: 140000001e00000032000000460000005a0000007d00000096000000b4000000d7000000fa000000
  - money: 640000002c01000058020000
